{
  "manifest_version": 3,
  "name": "Instant Sidebar Lyrics",
  "version": "3.5",
  "description": "Finds lyrics with smart matching and a search fallback. Saves user‑provided lyrics and submits missing lyrics to the LRCLIB community database.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://lrclib.net/*",
    "https://api.lyrics.ovh/*",
    "https://api.cors.lol/*",
    "https://api.allorigins.win/*",
    "https://corsproxy.io/*",
    "https://genius.com/*",
    "https://www.azlyrics.com/*",
    "https://www.letras.com/*",
    "https://html.duckduckgo.com/*",
    "https://www.bing.com/*",
    "https://api.genius.com/*",
    "https://api.deezer.com/*",
    "https://itunes.apple.com/*",
    "https://saavn.sumit.co/*",
    "https://open.spotify.com/*",
    "https://api.spotify.com/*",
    "https://music.youtube.com/*"
  ],
  "content_scripts": [{
    "matches": ["*://*.youtube.com/watch*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Lyrics Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
